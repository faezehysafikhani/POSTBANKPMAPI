<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>postbank-api</UserSecretsId>
    <!-- One place to move the host to another Core release. Must exist in the offline feed. -->
    <NexusCoreVersion>0.1.0.1405082006</NexusCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <!-- PostBank consumes the NexusCore platform as two bundle packages. Each brings the modules it composes
       (with their versions) transitively, so there is nothing else to list or keep in step:
         Nexus.Bundles.Platform           users, roles, sessions, organization, calendar, workflow,
                                          chat, events, ticketing, notifications
         Nexus.Bundles.ProjectManagement  every project-management module, its integrations, portfolio,
                                          reporting, plus actions, knowledge and strategy
       To use less, reference the individual Core packages instead of the bundle. -->
  <ItemGroup>
    <PackageReference Include="Nexus.Bundles.Platform" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Bundles.ProjectManagement" Version="$(NexusCoreVersion)" />
  </ItemGroup>

</Project>
