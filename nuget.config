<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline package source. Public feeds are cleared on purpose: the host restores only from ./offline-feed
  (the NexusCore packages plus every third-party package they need). Build that folder with
  eng/make-offline-feed.ps1 (or .sh) on a machine that can reach nuget.org, then copy it next to this file.
  In a bank network replace the path with the approved internal feed URL if one exists.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline-feed" value="./offline-feed" />
  </packageSources>
</configuration>
